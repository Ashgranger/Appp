<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Encrypted passwords are strictly local-only and excluded from cloud backups. -->
        <exclude domain="sharedpref" path="swiftweb_encrypted_passwords.xml" />
        <exclude domain="sharedpref" path="swiftweb_encrypted_passwords_test_fallback.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude hardware-backed encrypted preferences from device-to-device transfer. -->
        <exclude domain="sharedpref" path="swiftweb_encrypted_passwords.xml" />
        <exclude domain="sharedpref" path="swiftweb_encrypted_passwords_test_fallback.xml" />
    </device-transfer>
</data-extraction-rules>
